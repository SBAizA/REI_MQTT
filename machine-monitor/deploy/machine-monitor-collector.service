[Unit]
Description=Machine monitor MQTT -> SQLite collector
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/machine-monitor
EnvironmentFile=/home/pi/machine-monitor/machine-monitor.env
ExecStart=/home/pi/machine-monitor/.venv/bin/python collector.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
